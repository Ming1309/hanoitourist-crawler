# Local development credentials only. Never use these in production.
POSTGRES_USER=crawler
POSTGRES_PASSWORD=crawler_local
POSTGRES_DB=hanoitourist
POSTGRES_PORT=5432
DATABASE_URL=postgresql://crawler:crawler_local@localhost:5432/hanoitourist
TOUR_URL=https://hanoitourist.vn/kham-pha-phu-quoc-hon-ngoc-vien-dong
EXPORT_DIR=exports
HEADLESS=true
NAVIGATION_TIMEOUT=30
RUN_TIMEOUT=300
MAX_STATES=100
MAX_PAGES=50
MAX_DOCUMENT_BYTES=5242880
MAX_RUN_BYTES=52428800
REQUEST_INTERVAL=1
MAX_RETRIES=2
USER_AGENT=HanoitouristResearchCrawler/0.1
DOMESTIC_LISTING_URL=https://hanoitourist.vn/tour-trong-nuoc
RECHECK_DAYS=7
DISCOVERY_TIMEOUT=300
MAX_LISTING_PAGES=50
BATCH_TIMEOUT=21600
SCHEDULE_TIME=00:00
# Only Asia/Ho_Chi_Minh is supported; other timezone values are rejected.
SCHEDULE_TIMEZONE=Asia/Ho_Chi_Minh
SCHEDULER_POLL_INTERVAL=60
# Container-only DSN: update if POSTGRES_* changes; percent-encode special password characters.
SCHEDULER_DATABASE_URL=postgresql://crawler:crawler_local@postgres:5432/hanoitourist
# Set these to host uid/gid if the exports bind mount is not writable.
CRAWLER_UID=1000
CRAWLER_GID=1000
# Optional dedicated testing database; tests create and remove only their own schema.
# TEST_DATABASE_URL=postgresql://crawler:crawler_local@localhost:5432/hanoitourist
